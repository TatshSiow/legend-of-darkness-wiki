{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [{"source":"/optimized/:path*","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}]
}
